{
  "schema": "manus.game.backend-contract/v1",
  "deploy": {
    "mode": "hybrid",
    "dockerfilePath": "server/Dockerfile",
    "healthPath": "/api/leaderboards/v1/health"
  },
  "routes": [
    {
      "path": "/api/*",
      "target": "server"
    },
    {
      "path": "/*",
      "target": "static"
    }
  ],
  "api": {
    "protocolVersion": 1
  },
  "database": {
    "schemaVersion": 2
  },
  "boards": [
    {
      "id": "daily-v1",
      "rulesVersion": "v1"
    },
    {
      "id": "endless-v1",
      "rulesVersion": "v1"
    }
  ]
}
